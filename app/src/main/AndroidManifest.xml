<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="com.android.permission.GET_INSTALLED_APPS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Shows which MiuiHome implementation is running in the launcher option. -->
    <queries>
        <package android:name="com.miui.home" />
    </queries>

    <application
        android:name=".ModuleApplication"
        android:allowBackup="false"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".activity.PredictiveBackSettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.PredictiveBackAppListActivity"
            android:exported="false" />
        <activity
            android:name=".activity.GestureTriggerSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".activity.ContextualSearchSettingsActivity"
            android:exported="false" />
    </application>
</manifest>
